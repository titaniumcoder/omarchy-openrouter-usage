#!/usr/bin/python3
# omarchy:summary=Print the OpenRouter usage record as JSON
# omarchy:args=[--force] [--limits-only] [--period 7d|1mo|3mo]
# omarchy:hidden=true
"""Collect OpenRouter usage into one display-ready JSON record.

Everything the agents panel shows for OpenRouter comes from this one
command: local session stats from pi/omp sessions that ran on the
OpenRouter provider, and the authoritative credit balance and key usage
from OpenRouter's REST API. The panel itself only ever reads the JSON
this prints; it never talks to disk formats or endpoints.

The API key comes from OPENROUTER_API_KEY or from
~/.config/omarchy/agents/openrouter.json ({"apiKey": "sk-or-..."}), so
timers without a login shell environment can still probe the account.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import secrets
import signal
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "openrouter"
AGENT_NAME = "OpenRouter"
AUTH_HELP = "Set OPENROUTER_API_KEY or add apiKey to ~/.config/omarchy/agents/openrouter.json."
API_BASE_URL = "https://openrouter.ai/api/v1"
PROBE_MIN_INTERVAL_SECONDS = 15
ACTIVITY_CACHE_SECONDS = 300
VALID_PERIODS = ("7d", "1mo", "3mo")
PERIOD_DAYS = {"7d": 7, "1mo": 30, "3mo": 90}
MAX_PRIVATE_FILE_BYTES = 512 * 1024
MAX_HTTP_BYTES = 256 * 1024
MAX_TRANSCRIPT_FILES = 512
MAX_TRANSCRIPT_BYTES = 2 * 1024 * 1024
MAX_SCAN_BYTES = 32 * 1024 * 1024
MAX_LINE_BYTES = 256 * 1024
MAX_MODEL_NAME = 160
MAX_MODELS = 128
MAX_RECORD_BYTES = 1024 * 1024
SCAN_DEADLINE_SECONDS = 8
COLLECT_DEADLINE_SECONDS = 25
TRANSCRIPT_MAX_AGE_DAYS = 120
MAGIC_OBJECT_KEYS = {"__proto__", "constructor", "prototype"}


class CollectionDeadline(RuntimeError):
  pass


def _deadline_expired(_signum, _frame):
  raise CollectionDeadline("collector deadline exceeded")


def clean_text(value: Any, limit: int = 256) -> str:
  text = str(value or "")
  return "".join(char for char in text if char >= " " and char != "\x7f")[:limit]


def safe_data_key(value: Any, fallback: str = "other") -> str:
  key = clean_text(value, MAX_MODEL_NAME) or fallback
  return fallback if key in MAGIC_OBJECT_KEYS else key


def _validate_dir(fd: int, *, private: bool = False) -> None:
  info = os.fstat(fd)
  if not stat.S_ISDIR(info.st_mode) or info.st_uid not in (0, os.getuid()):
    raise OSError("unsafe directory owner or type")
  if info.st_uid == os.getuid() and info.st_mode & 0o022:
    raise OSError("unsafe writable directory")
  if private and info.st_uid == os.getuid() and stat.S_IMODE(info.st_mode) != 0o700:
    os.fchmod(fd, 0o700)


def open_owned_dir(path: Path, *, create: bool = False, private: bool = False) -> int:
  """Open an absolute directory without following any pathname component."""
  absolute = path.expanduser()
  if not absolute.is_absolute():
    raise OSError("directory path must be absolute")
  parts = absolute.parts[1:]
  fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
  user_scope = False
  try:
    root_info = os.fstat(fd)
    if root_info.st_uid != 0 or root_info.st_mode & 0o022:
      raise OSError("unsafe filesystem root")
    for index, part in enumerate(parts):
      if part in ("", ".", ".."):
        raise OSError("unsafe directory component")
      try:
        child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=fd)
      except FileNotFoundError:
        if not create:
          raise
        os.mkdir(part, 0o700, dir_fd=fd)
        child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=fd)
      os.close(fd)
      fd = child
      info = os.fstat(fd)
      if info.st_uid == os.getuid():
        user_scope = True
      # Before entering the caller's tree, only non-writable root-owned
      # system ancestors are accepted. Ownership cannot change afterward.
      if user_scope:
        if info.st_uid != os.getuid():
          raise OSError("unsafe directory ownership transition")
        _validate_dir(fd, private=private and index == len(parts) - 1)
      elif info.st_uid != 0 or info.st_mode & 0o022:
        raise OSError("unsafe system directory ancestor")
      elif index == len(parts) - 1:
        raise OSError("sensitive directory is not user-owned")
    return fd
  except Exception:
    os.close(fd)
    raise


def _validate_transcript_dir(fd: int) -> None:
  info = os.fstat(fd)
  if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
      or info.st_mode & 0o022):
    raise OSError("unsafe transcript directory")


def iter_transcript_files(root: Path, deadline: float):
  """Yield verified transcript leaf fds from a held, no-follow directory tree."""
  try:
    root_fd = open_owned_dir(root)
    _validate_transcript_dir(root_fd)
  except OSError:
    return

  stack: list[tuple[int, str, int]] = [(root_fd, str(root), 0)]
  try:
    while stack:
      if time.monotonic() >= deadline:
        break
      directory_fd, display_path, depth = stack.pop()
      try:
        if depth > 16:
          continue
        with os.scandir(directory_fd) as entries:
          for entry in entries:
            if time.monotonic() >= deadline:
              break
            name = entry.name
            if name in (".", ".."):
              continue
            try:
              info = entry.stat(follow_symlinks=False)
              if stat.S_ISDIR(info.st_mode):
                child_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW, dir_fd=directory_fd)
                try:
                  child_info = os.fstat(child_fd)
                  _validate_transcript_dir(child_fd)
                  if (child_info.st_dev, child_info.st_ino) != (info.st_dev, info.st_ino):
                    raise OSError("transcript directory changed during traversal")
                except Exception:
                  os.close(child_fd)
                  continue
                stack.append((child_fd, f"{display_path}/{name}", depth + 1))
              elif name.endswith(".jsonl") and stat.S_ISREG(info.st_mode):
                leaf_fd = os.open(name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory_fd)
                leaf_info = os.fstat(leaf_fd)
                if (not stat.S_ISREG(leaf_info.st_mode) or leaf_info.st_uid != os.getuid()
                    or (leaf_info.st_dev, leaf_info.st_ino) != (info.st_dev, info.st_ino)):
                  os.close(leaf_fd)
                  continue
                yield leaf_fd, leaf_info, f"{display_path}/{name}"
            except OSError:
              continue
      finally:
        os.close(directory_fd)
  finally:
    for directory_fd, _display_path, _depth in stack:
      os.close(directory_fd)


def read_private_json(path: Path, limit: int = MAX_PRIVATE_FILE_BYTES) -> dict[str, Any] | None:
  try:
    parent_fd = open_owned_dir(path.parent)
    try:
      fd = os.open(path.name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent_fd)
      try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
          return None
        if info.st_size > limit:
          return None
        chunks: list[bytes] = []
        remaining = limit + 1
        while remaining > 0:
          chunk = os.read(fd, min(65536, remaining))
          if not chunk:
            break
          chunks.append(chunk)
          remaining -= len(chunk)
        raw = b"".join(chunks)
        if len(raw) > limit:
          return None
        parsed = json.loads(raw.decode("utf-8"))
        return parsed if isinstance(parsed, dict) else None
      finally:
        os.close(fd)
    finally:
      os.close(parent_fd)
  except (OSError, UnicodeError, json.JSONDecodeError):
    return None


def cache_root() -> Path:
  root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
  fd = open_owned_dir(root, create=True, private=True)
  os.close(fd)
  return root


def config_path() -> Path:
  config_home = Path(os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config"))
  return config_home / "omarchy" / "agents" / "openrouter.json"


def date_string(value: dt.date) -> str:
  return value.strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
  today = dt.datetime.now().date()
  return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def local_date_string() -> str:
  return date_string(dt.datetime.now().date())


def local_date_from_timestamp(value: Any) -> str:
  if value is None:
    return local_date_string()

  if isinstance(value, (int, float)):
    try:
      seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
      return date_string(dt.datetime.fromtimestamp(seconds).date())
    except Exception:
      return local_date_string()

  raw = str(value).strip()
  if not raw:
    return local_date_string()
  try:
    parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    return date_string(parsed.astimezone().date())
  except Exception:
    return raw[:10] if len(raw) >= 10 else local_date_string()


def usage_token(usage: dict[str, Any], *keys: str) -> int:
  for key in keys:
    if key in usage:
      return number(usage.get(key))
  return 0


def number(value: Any) -> int:
  try:
    return max(0, round(float(value or 0)))
  except (TypeError, ValueError):
    return 0


def money(value: Any) -> float:
  try:
    return max(0.0, float(value or 0))
  except (TypeError, ValueError):
    return 0.0


def ratio(value: Any) -> float:
  try:
    n = float(value or 0)
  except (TypeError, ValueError):
    return 0.0
  if n > 1.0:
    n = n / 100.0
  return max(0.0, min(1.0, n))


def empty_bucket() -> dict[str, Any]:
  return {
    "inputTokens": 0,
    "outputTokens": 0,
    "cacheReadInputTokens": 0,
    "cacheCreationInputTokens": 0,
    # pi rates every message at the provider's price sheet; carrying the
    # dollars beside the tokens lets the panel chart spend instead of
    # volume. Collectors without rated costs simply omit the field.
    "cost": 0.0,
  }


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
  try:
    parent_fd = open_owned_dir(path.parent, private=True)
    try:
      fd = os.open(path.name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent_fd)
      try:
        info = os.fstat(fd)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > MAX_PRIVATE_FILE_BYTES
            or time.time() - info.st_mtime > max_age_seconds):
          return None
        raw = os.read(fd, MAX_PRIVATE_FILE_BYTES + 1)
        if len(raw) > MAX_PRIVATE_FILE_BYTES:
          return None
        data = json.loads(raw.decode("utf-8"))
        return data if isinstance(data, dict) else None
      finally:
        os.close(fd)
    finally:
      os.close(parent_fd)
  except (OSError, UnicodeError, json.JSONDecodeError):
    return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
  encoded = json.dumps(payload, separators=(",", ":")).encode("utf-8")
  if len(encoded) > MAX_PRIVATE_FILE_BYTES:
    raise ValueError("cache record too large")
  directory_fd = open_owned_dir(path.parent, create=True, private=True)
  tmp_name = f".{path.name}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
  fd = os.open(tmp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600, dir_fd=directory_fd)
  try:
    offset = 0
    while offset < len(encoded):
      offset += os.write(fd, encoded[offset:])
    os.fsync(fd)
    os.close(fd)
    fd = -1
    os.replace(tmp_name, path.name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
    os.fsync(directory_fd)
  finally:
    if fd >= 0:
      os.close(fd)
    try:
      os.unlink(tmp_name, dir_fd=directory_fd)
    except FileNotFoundError:
      pass
    os.close(directory_fd)


# ---------------------------------------------------------------- sessions
#
# pi and omp record per-message provider, model, token usage, and rated
# cost in their session transcripts. Only messages whose provider is
# OpenRouter count here; the same sessions may also feed other collectors
# (the Claude collector claims the anthropic-provider messages), so the
# split keeps every token attributed exactly once.


def scan_pi_usage(max_age_seconds: float) -> dict[str, Any]:
  roots = [
    Path.home() / ".pi" / "agent" / "sessions",
    Path.home() / ".omp" / "agent" / "sessions",
  ]
  cache_file = cache_root() / "openrouter-pi-sessions.json"
  cached = read_fresh_json(cache_file, max_age_seconds)
  if cached is not None and isinstance(cached.get("stats"), dict):
    return cached["stats"]

  today = local_date_string()
  recent_dates = recent_date_strings()
  recent = {day: {"date": day, "messageCount": 0, "prompts": 0, "cost": 0.0} for day in recent_dates}
  sessions: set[str] = set()
  active_days: set[str] = set()
  today_sessions: set[str] = set()
  today_tokens: dict[str, int] = {}
  usage_by_model: dict[str, dict[str, int]] = {}
  seen: set[str] = set()
  prompts = 0
  today_prompt_count = 0
  today_token_total = 0
  today_cost = 0.0
  scan_started = time.monotonic()
  scanned_files = 0
  scanned_bytes = 0
  oldest_allowed = time.time() - TRANSCRIPT_MAX_AGE_DAYS * 86400
  scan_deadline = scan_started + SCAN_DEADLINE_SECONDS

  for root in roots:
    files = iter_transcript_files(root, scan_deadline)
    for fd, info, session_path in files:
      if scanned_files >= MAX_TRANSCRIPT_FILES or scanned_bytes >= MAX_SCAN_BYTES or time.monotonic() - scan_started >= SCAN_DEADLINE_SECONDS:
        os.close(fd)
        files.close()
        break
      try:
        if info.st_mtime < oldest_allowed or info.st_size > MAX_TRANSCRIPT_BYTES:
          os.close(fd)
          continue
        scanned_files += 1
        file_bytes = 0
        with os.fdopen(fd, "rb", closefd=True) as raw_handle:
          for line_number in range(1, 1_000_001):
            if time.monotonic() - scan_started >= SCAN_DEADLINE_SECONDS:
              break
            raw_line = raw_handle.readline(MAX_LINE_BYTES + 1)
            if not raw_line:
              break
            file_bytes += len(raw_line)
            scanned_bytes += len(raw_line)
            if len(raw_line) > MAX_LINE_BYTES or file_bytes > MAX_TRANSCRIPT_BYTES or scanned_bytes > MAX_SCAN_BYTES:
              break
            line = raw_line.decode("utf-8", errors="replace")
            if '"usage"' not in line or '"assistant"' not in line:
              continue
            try:
              entry = json.loads(line)
              message = entry.get("message") if isinstance(entry.get("message"), dict) else {}
              if entry.get("type") != "message" or message.get("role") != "assistant":
                continue
              if str(message.get("provider") or "") != "openrouter":
                continue
              unique_key = f"{session_path}:{entry.get('id') or line_number}"
              if unique_key in seen:
                continue
              seen.add(unique_key)
              usage = message.get("usage") or {}
              input_tokens = usage_token(usage, "input", "inputTokens")
              output_tokens = usage_token(usage, "output", "outputTokens")
              cache_read = usage_token(usage, "cacheRead", "cache_read_input_tokens")
              cache_write = usage_token(usage, "cacheWrite", "cache_creation_input_tokens")
              total = input_tokens + output_tokens + cache_read + cache_write
              if total <= 0:
                total = number(usage.get("totalTokens"))
                input_tokens = total
              if total <= 0:
                continue
              model = safe_data_key(message.get("model") or "openrouter", "openrouter")
              day = local_date_from_timestamp(entry.get("timestamp") or message.get("timestamp"))
              cost = money((usage.get("cost") or {}).get("total") if isinstance(usage.get("cost"), dict) else usage.get("cost"))
            except Exception:
              continue

            session_key = session_path
            sessions.add(session_key)
            active_days.add(day)
            prompts += 1
            if model not in usage_by_model and len(usage_by_model) >= MAX_MODELS:
              model = "other"
            bucket = usage_by_model.setdefault(model, empty_bucket())
            bucket["inputTokens"] += input_tokens
            bucket["outputTokens"] += output_tokens
            bucket["cacheReadInputTokens"] += cache_read
            bucket["cacheCreationInputTokens"] += cache_write
            bucket["cost"] = round(bucket["cost"] + cost, 6)
            if day in recent:
              recent[day]["messageCount"] += total
              recent[day]["prompts"] += 1
              recent[day]["cost"] = round(recent[day]["cost"] + cost, 6)
            if day == today:
              today_prompt_count += 1
              today_sessions.add(session_key)
              today_token_total += total
              today_tokens[model] = today_tokens.get(model, 0) + total
              today_cost += cost
      except OSError:
        continue

  stats = {
    "hasCostStats": True,
    "todayPrompts": today_prompt_count,
    "todaySessions": len(today_sessions),
    "todayTotalTokens": today_token_total,
    "todayTokensByModel": today_tokens,
    "recentDays": [recent[day] for day in recent_dates],
    "modelUsage": usage_by_model,
    "totalPrompts": prompts,
    "totalSessions": len(sessions),
    "activeDays": len(active_days),
    "activeDates": sorted(active_days),
    "todayLocalCost": round(today_cost, 6),
  }
  write_json(cache_file, {"stats": stats})
  return stats


def cached_scan(max_age_seconds: float) -> dict[str, Any]:
  directory_fd = open_owned_dir(cache_root(), create=True, private=True)
  try:
    fd = os.open("openrouter-pi-sessions.lock", os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600, dir_fd=directory_fd)
    try:
      info = os.fstat(fd)
      if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
        raise OSError("unsafe cache lock")
      if stat.S_IMODE(info.st_mode) != 0o600:
        os.fchmod(fd, 0o600)
      fcntl.flock(fd, fcntl.LOCK_EX)
      return scan_pi_usage(max_age_seconds)
    finally:
      os.close(fd)
  finally:
    os.close(directory_fd)


# ------------------------------------------------------------------- limits
#
# OpenRouter is prepaid, so the account has a balance rather than a plan
# quota: /credits reports lifetime purchases and rated usage, and /key
# reports this key's daily, weekly, and monthly spend plus any per-key
# limit. A per-key limit becomes a percent bar; without one the spend
# figures travel in usageStatusText and the balance block carries the
# remaining credit.


def read_config() -> dict[str, Any]:
  return read_private_json(config_path(), 16 * 1024) or {}


def api_key() -> str:
  key = clean_text(os.environ.get("OPENROUTER_API_KEY", ""), 512).strip()
  if key:
    return key
  return clean_text(read_config().get("apiKey"), 512).strip()


def management_key() -> str:
  key = clean_text(os.environ.get("OPENROUTER_MANAGEMENT_KEY", ""), 512).strip()
  if key:
    return key
  return clean_text(read_config().get("managementKey"), 512).strip()


class _NoRedirect(urllib.request.HTTPRedirectHandler):
  # urllib's default handler re-sends every header — including
  # Authorization — to whatever host a redirect names. The OpenRouter API
  # never redirects these endpoints in normal operation, so any redirect
  # is a reason to stop, not to follow with the key attached.
  def redirect_request(self, req, fp, code, msg, headers, newurl):
    raise urllib.error.HTTPError(req.full_url, code, "redirect refused", headers, fp)


_opener = urllib.request.build_opener(_NoRedirect)


def api_request(path: str, key: str, method: str = "GET", body: dict[str, Any] | None = None) -> dict[str, Any]:
  headers = {"Authorization": "Bearer " + key, "Accept": "application/json"}
  encoded: bytes | None = None
  if body is not None:
    encoded = json.dumps(body).encode("utf-8")
    headers["Content-Type"] = "application/json"
  request = urllib.request.Request(
    API_BASE_URL + path,
    data=encoded,
    headers=headers,
    method=method,
  )
  with _opener.open(request, timeout=10) as response:
    final = urllib.parse.urlsplit(response.geturl())
    expected = urllib.parse.urlsplit(API_BASE_URL)
    if final.scheme != "https" or final.hostname != expected.hostname or final.port not in (None, 443):
      raise urllib.error.URLError("unexpected response origin")
    raw = response.read(MAX_HTTP_BYTES + 1)
    if len(raw) > MAX_HTTP_BYTES:
      raise ValueError("OpenRouter response too large")
    payload = json.loads(raw.decode("utf-8"))
  data = payload.get("data") if isinstance(payload, dict) else None
  return data if isinstance(data, dict) else {}


def probe_account(key: str) -> dict[str, Any]:
  try:
    credits = api_request("/credits", key)
    key_info = api_request("/key", key)
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      return {"ok": False, "helpText": "OpenRouter rejected the API key. " + AUTH_HELP}
    return {"ok": False, "helpText": f"OpenRouter's API returned status {error.code}. Local pi stats are still shown."}
  except Exception:
    # A transport failure reached no server at all — no route, no DNS. Any
    # real answer, including an error status, is a server we should stop
    # pestering; this is not.
    return {
      "ok": False,
      "transport": True,
      "helpText": "Couldn't reach OpenRouter. Retrying shortly. Local pi stats are still shown.",
    }

  # /credits reports lifetime purchases and lifetime usage. Presenting those
  # as the panel's funded/spent gauge is misleading on a top-up account: the
  # remaining sliver of a years-long total reads as a permanent low-balance
  # alarm. Only the live remainder is a truth worth charting; a gauge needs
  # a user-declared budget (fundedAmount in openrouter.json, same contract
  # as the fireworks collector) to make the drained fraction meaningful.
  lifetime_funded = money(credits.get("total_credits"))
  lifetime_spent = money(credits.get("total_usage"))
  remaining = max(0.0, lifetime_funded - lifetime_spent)
  budget = money(read_config().get("fundedAmount"))
  result: dict[str, Any] = {
    "ok": True,
    "balance": {
      "remaining": round(remaining, 6),
      "funded": round(budget, 2) if budget > 0 else 0,
      "spent": round(max(0.0, budget - remaining), 6) if budget > 0 else 0,
      "currency": "USD",
      "estimated": False,
    },
    "limits": [],
    "tierLabel": "Free tier" if key_info.get("is_free_tier") else "Prepaid",
  }

  # Only an explicit per-key limit yields a meaningful percent bar; an
  # unlimited key gets its spend narrated instead of charted.
  limit = key_info.get("limit")
  if isinstance(limit, (int, float)) and limit > 0:
    used = money(key_info.get("usage")) if key_info.get("limit_remaining") is None else money(limit) - money(key_info.get("limit_remaining"))
    result["limits"].append({
      "label": "Key limit",
      "percent": min(1.0, max(0.0, used / float(limit))),
      "resetsAt": "",
    })

  # usageStatusText is the panel's error channel: any non-empty value
  # renders as an urgent card with authHelpText as the remedy. A healthy
  # probe must leave it empty; the balance block already tells the story.
  result["usageStatusText"] = ""
  result["authHelpText"] = ""
  return result


def collect_account(force: bool) -> dict[str, Any]:
  result: dict[str, Any] = {"limits": [], "usageStatusText": "", "authHelpText": "", "tierLabel": ""}

  key = api_key()
  if key == "":
    result["usageStatusText"] = "Waiting for auth"
    result["authHelpText"] = AUTH_HELP
    return result

  # A panel that is opened and shut repeatedly must not turn into a request
  # per flick, so recent probe results are reused for a short window — and
  # kept as the answer of record when a later probe fails.
  probe_cache = cache_root() / "openrouter-account.json"
  cached = read_fresh_json(probe_cache, float("inf")) or {}
  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  min_interval = 0 if force else PROBE_MIN_INTERVAL_SECONDS
  if cached.get("account") and time.time() - fetched_at < max(min_interval, PROBE_MIN_INTERVAL_SECONDS):
    result.update(cached["account"])
    return result

  probe = probe_account(key)
  if probe["ok"]:
    account = {
      "balance": probe["balance"],
      "limits": probe["limits"],
      "tierLabel": probe["tierLabel"],
      "usageStatusText": "",
    }
    result.update(account)
    write_json(probe_cache, {"fetchedAtMs": round(time.time() * 1000), "account": account})
    return result

  # The first probe after login often fires before DHCP has handed out a
  # route. Ask the shell to try again sooner than its regular interval.
  if probe.get("transport"):
    result["retryAdvised"] = True
  if cached.get("account"):
    result.update(cached["account"])
  else:
    result["usageStatusText"] = "OpenRouter account unavailable"
    result["authHelpText"] = probe["helpText"]
  return result


# ------------------------------------------------------------------ activity
#
# The Details section wants the same four cards as OpenRouter's Activity
# overview, plus top apps and keys. Those ranked lists only exist on the
# Analytics API, which rejects inference keys (403) and wants a management
# key. Without one we still fill the cards from the local 7-day scan so
# the section is never empty.


def analytics_rows(result: dict[str, Any]) -> list[dict[str, Any]]:
  rows = result.get("data")
  if not isinstance(rows, list):
    return []
  return [row for row in rows[:64] if isinstance(row, dict)]


def ranked_tokens(rows: list[dict[str, Any]], name_key: str, limit: int) -> list[dict[str, Any]]:
  items: list[dict[str, Any]] = []
  for row in rows:
    raw = row.get(name_key)
    if raw is None:
      continue
    label = clean_text(raw, MAX_MODEL_NAME).strip()
    if label == "" or label.lower() in ("null", "none", "unset", "(unset)"):
      continue
    items.append({
      "name": label,
      "tokens": number(row.get("tokens_total")),
      "cost": money(row.get("total_usage")),
    })
  items.sort(key=lambda item: item["tokens"], reverse=True)
  return items[:limit]


def ranked_local_models(usage_by_model: Any, limit: int) -> list[dict[str, Any]]:
  items: list[dict[str, Any]] = []
  if not isinstance(usage_by_model, dict):
    return items
  for model_id, bucket in usage_by_model.items():
    if not isinstance(bucket, dict):
      continue
    tokens = (
      number(bucket.get("inputTokens"))
      + number(bucket.get("outputTokens"))
      + number(bucket.get("cacheReadInputTokens"))
      + number(bucket.get("cacheCreationInputTokens"))
    )
    items.append({
      "name": clean_text(model_id, MAX_MODEL_NAME),
      "tokens": tokens,
      "cost": money(bucket.get("cost")),
    })
  items.sort(key=lambda item: item["tokens"], reverse=True)
  return items[:limit]


def period_time_range(period: str) -> dict[str, str]:
  days = PERIOD_DAYS.get(period, 30)
  end = dt.datetime.now(dt.timezone.utc)
  start = end - dt.timedelta(days=days)
  return {
    "start": start.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "end": end.strftime("%Y-%m-%dT%H:%M:%SZ"),
  }


def local_activity(stats: dict[str, Any], period: str) -> dict[str, Any]:
  recent = stats.get("recentDays") or []
  spend = 0.0
  requests = 0
  tokens = 0
  for day in recent:
    if not isinstance(day, dict):
      continue
    spend += money(day.get("cost"))
    requests += number(day.get("prompts"))
    tokens += number(day.get("messageCount"))
  cache_read = 0
  input_tokens = 0
  usage_by_model = stats.get("modelUsage") or {}
  if isinstance(usage_by_model, dict):
    for bucket in usage_by_model.values():
      if not isinstance(bucket, dict):
        continue
      cache_read += number(bucket.get("cacheReadInputTokens"))
      input_tokens += number(bucket.get("inputTokens"))
  denom = cache_read + input_tokens
  return {
    "period": period,
    "source": "local",
    "spend": round(spend, 6),
    "requests": requests,
    "tokens": tokens,
    "cacheHitRate": (cache_read / denom) if denom > 0 else 0.0,
    "topModels": ranked_local_models(usage_by_model, 3),
    "topApps": [],
    "topKeys": [],
    "needsManagementKey": True,
  }


def probe_activity(key: str, period: str) -> dict[str, Any]:
  time_range = period_time_range(period)
  try:
    overview = api_request("/analytics/query", key, method="POST", body={
      "metrics": ["total_usage", "request_count", "tokens_total", "cache_hit_rate"],
      "time_range": time_range,
    })
    models = api_request("/analytics/query", key, method="POST", body={
      "metrics": ["tokens_total", "total_usage"],
      "dimensions": ["model"],
      "order_by": {"field": "tokens_total", "direction": "desc"},
      "limit": 3,
      "time_range": time_range,
    })
    apps = api_request("/analytics/query", key, method="POST", body={
      "metrics": ["tokens_total"],
      "dimensions": ["app"],
      "order_by": {"field": "tokens_total", "direction": "desc"},
      "limit": 3,
      "time_range": time_range,
    })
    keys = api_request("/analytics/query", key, method="POST", body={
      "metrics": ["tokens_total"],
      "dimensions": ["api_key_id"],
      "order_by": {"field": "tokens_total", "direction": "desc"},
      "limit": 3,
      "time_range": time_range,
    })
  except urllib.error.HTTPError as error:
    if error.code in (401, 403):
      return {"ok": False, "needsManagementKey": True}
    return {"ok": False, "helpText": f"OpenRouter analytics returned status {error.code}."}
  except Exception:
    return {"ok": False, "transport": True}

  overview_rows = analytics_rows(overview)
  meta = overview.get("metadata") if isinstance(overview.get("metadata"), dict) else {}
  if meta.get("truncated"):
    print("openrouter-usage: analytics overview truncated", file=sys.stderr)
  row = overview_rows[0] if overview_rows else {}
  return {
    "ok": True,
    "activity": {
      "period": period,
      "source": "analytics",
      "spend": round(money(row.get("total_usage")), 6),
      "requests": number(row.get("request_count")),
      "tokens": number(row.get("tokens_total")),
      "cacheHitRate": ratio(row.get("cache_hit_rate")),
      "topModels": ranked_tokens(analytics_rows(models), "model", 3),
      "topApps": ranked_tokens(analytics_rows(apps), "app", 3),
      "topKeys": ranked_tokens(analytics_rows(keys), "api_key_id", 3),
      "needsManagementKey": False,
    },
  }


def collect_activity(period: str, force: bool, limits_only: bool, stats: dict[str, Any]) -> dict[str, Any]:
  if period not in VALID_PERIODS:
    period = "1mo"
  fallback = local_activity(stats, period)
  cache_file = cache_root() / f"openrouter-activity-{period}.json"
  max_age = 0 if force else (900 if limits_only else ACTIVITY_CACHE_SECONDS)
  if max_age > 0:
    cached = read_fresh_json(cache_file, float(max_age))
    if cached is not None and isinstance(cached.get("activity"), dict):
      return cached["activity"]

  key = management_key()
  if key == "":
    return fallback

  probe = probe_activity(key, period)
  if probe.get("ok") and isinstance(probe.get("activity"), dict):
    write_json(cache_file, {"activity": probe["activity"]})
    return probe["activity"]

  stale = read_fresh_json(cache_file, float("inf")) or {}
  if isinstance(stale.get("activity"), dict):
    return stale["activity"]
  if probe.get("needsManagementKey"):
    fallback["needsManagementKey"] = True
  return fallback


# -------------------------------------------------------------------- record


def main() -> int:
  signal.signal(signal.SIGALRM, _deadline_expired)
  signal.alarm(COLLECT_DEADLINE_SECONDS)
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true", help="rescan sessions and re-probe the account, ignoring caches")
  parser.add_argument("--limits-only", action="store_true", help="reuse any recent session scan; only the account probe must be fresh")
  parser.add_argument("--period", choices=list(VALID_PERIODS), default="1mo", help="activity window for the Details section")
  parser.add_argument("--cache-seconds", type=float, default=20)
  args = parser.parse_args()

  scan_age = 0 if args.force else (900 if args.limits_only else args.cache_seconds)
  stats = cached_scan(scan_age)
  account = collect_account(args.force)
  activity = collect_activity(args.period, args.force, args.limits_only, stats)

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
    "ready": number(stats.get("totalPrompts")) > 0 or bool(account.get("balance")),
    "hasLocalStats": True,
    # The balance and spend figures are account-global, not machine-local:
    # every synced device reports the same truth, so aggregation must not
    # sum them. Session stats are local, hence hasLocalStats above.
    "scope": "account",
    "tierLabel": account.get("tierLabel") or "",
    "usageStatusText": account.get("usageStatusText") or "",
    "authHelpText": account.get("authHelpText") or "",
    "limits": account.get("limits") or [],
    "activity": activity,
  }
  if account.get("balance"):
    record["balance"] = account["balance"]
  if account.get("retryAdvised"):
    record["retryAdvised"] = True
  record.update(stats)
  encoded = json.dumps(record, separators=(",", ":"), sort_keys=True)
  if len(encoded.encode("utf-8")) > MAX_RECORD_BYTES:
    raise ValueError("collector record exceeds output limit")
  print(encoded)
  signal.alarm(0)
  return 0


if __name__ == "__main__":
  raise SystemExit(main())
